JWT_SECRET=your_secret_here

# Directory for persisted FAISS index and metadata
# DATA_DIR=./data

# Default credentials: admin / secret (see app/db/users.py to change)
# JWT_ALGORITHM=HS256
# JWT_EXPIRY_MINUTES=60

# LLM provider: "openai" | "google" | "ollama"
LLM_PROVIDER=openai

# Required when LLM_PROVIDER=openai
OPENAI_API_KEY=your_key_here
# OPENAI_MODEL=gpt-4.1-mini

# Used when LLM_PROVIDER=google (get key from aistudio.google.com)
# GOOGLE_API_KEY=your_key_here
# GOOGLE_MODEL=gemini-2.0-flash

# Used when LLM_PROVIDER=ollama (Ollama must be running locally)
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=mistral:7b